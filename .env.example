# Required
BOT_TOKEN=123456:ABC-your-token
# Comma separated Telegram user IDs (owners). Owners can add more admins in the panel.
ADMIN_IDS=111111111,222222222

# Optional
# Local default is SQLite. On Render this is injected automatically from render.yaml.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Optional: public https URL of your service. On Render it's auto-detected (RENDER_EXTERNAL_URL).
# If empty, the bot runs in long-polling mode (good for local / Termux).
# WEBHOOK_URL=https://your-app.onrender.com
