# Required for the web dashboard (login password)
DASHBOARD_PASSWORD=choose-a-strong-password
# Your Telegram user id(s) – admins of EVERY bot (/admin inside each bot)
ADMIN_IDS=111111111,222222222

# Optional: your first bot. More bots can be added from the dashboard.
BOT_TOKEN=

# Optional
# DATABASE_URL=postgresql://user:pass@host:5432/dbname   (empty = local SQLite file)
# WEBHOOK_URL=https://your-app.onrender.com               (Render sets it automatically; empty = long polling)
# SECRET_KEY=any-long-random-string
